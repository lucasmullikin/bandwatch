#!/usr/bin/env python3
"""Capture a Meteor-M LRPT pass and decode it to an image.

    bw-capture-meteor --list          what is coming
    bw-capture-meteor --next          take the best upcoming pass
    bw-capture-meteor --at <ISO>      take a specific pass
    bw-capture-meteor --selftest      prove the radio and pipeline open, now

WHY THIS EXISTS SEPARATELY FROM bw-capture-sat

NOAA APT is gone. NOAA-18 was decommissioned 2025-06-06, NOAA-19 on 08-13 and
NOAA-15 on 08-19, so nothing transmits on 137.1/137.62/137.9125 any more. A
full 36-degree NOAA-18 pass recorded here on 2026-09-01 produced no 2400 Hz
APT subcarrier and decoded to pure noise -- the pipeline was perfect and the
premise was dead.

Meteor-M N2-3 and N2-4 still transmit LRPT on 137.9 MHz, so the antenna and
the band are unchanged. Everything else is different:

  APT was ANALOG FM  -> rtl_fm demodulated it, output was audio, satdump read
                        a WAV
  LRPT is DIGITAL QPSK -> there is no audio. It needs IQ baseband, so satdump
                        drives the SDR itself and never sees a WAV.

That is why this does not reuse the rtl_fm chain. Handing LRPT to an FM
demodulator produces exactly the noise that fooled us once already.
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
import bandwatch_config as C  # noqa: E402
sys.path.insert(0, os.path.join(ROOT, "lanes"))
STATE = os.path.join(ROOT, "var", "state.json")
OUTDIR = os.path.join(ROOT, "var", "lrpt")
TLE = os.path.join(ROOT, "var", "meteor.tle")
PAUSE_FMT = "/tmp/sdr_pause_dev%s"
# --- site -------------------------------------------------------------
# From config, never hardcoded. Satellite geometry is computed FROM this point:
# a wrong coordinate does not fail, it predicts passes over somewhere else and
# looks exactly like a correct prediction.
#
# Keep it approximate. Three decimal places is a city block and buys no useful
# accuracy for a pass prediction; your exact address should not appear in
# source, in a config file you might share, or in any request built from these
# constants.
SITE = C.station()

# Both active Meteor-M satellites use 137.9 MHz for LRPT (137.1 is N2-4's
# documented backup). One frequency keeps this simple.
LRPT_HZ = 137_900_000
LRPT_BACKUP_HZ = 137_100_000
CATNR = {"METEOR-M2 3": 57166, "METEOR-M2 4": 59051}
# 1.024 MS/s is the usual RTL-SDR rate for LRPT: comfortably above the ~150 kHz
# the 72 kbaud QPSK needs, and a rate the dongle actually supports cleanly.
SAMPLERATE = 1.024e6
PIPELINE = "meteor_m2-x_lrpt"
MARGIN_S = 60

_paused = []


def log(m):
    print("%s  %s" % (datetime.now(timezone.utc).strftime("%H:%M:%S"), m),
          flush=True)


def cleanup(*_a):
    for d in list(_paused):
        try:
            os.unlink(PAUSE_FMT % d)
            log("released radio %s" % d)
        except OSError:
            pass
        _paused.remove(d)


def satdump_bin():
    """The binary INSIDE the app bundle. satdump resolves its config, plugins
    and pipelines relative to its own path, so the brew symlink makes it look
    in /usr/local/share and die."""
    for c in (os.path.expanduser(
                  "~/Applications/SatDump.app/Contents/MacOS/satdump"),
              "/Applications/SatDump.app/Contents/MacOS/satdump"):
        if os.path.exists(c):
            return c
    return "satdump"


def low_band_radio():
    """Physical index AND serial of the radio carrying the 137 MHz antenna.

    Read from broker state, never assumed: USB enumeration order swapped
    across a reboot here, and satdump selects a device by SERIAL, which is a
    different identifier again.
    """
    phys, serial = "0", None
    try:
        st = json.load(open(STATE))
        for key, dev in (st.get("devices") or {}).items():
            if "LOW BAND" in (dev.get("label") or "").upper():
                phys = str(dev.get("physical_index", key))
                break
    except Exception:
        pass
    # map physical index -> serial, the way satdump identifies devices
    try:
        r = subprocess.run([os.path.join(os.path.expanduser("~"), "homebrew",
                                         "bin", "rtl_test"), "-t"],
                           capture_output=True, text=True, timeout=25,
                           stdin=subprocess.DEVNULL)
        import re
        for idx, sn in re.findall(r"^\s*(\d+):.*SN:\s*(\S+)",
                                  r.stdout + r.stderr, re.M):
            if idx == phys:
                serial = sn
    except Exception:
        pass
    return phys, serial


def wait_for_release(phys, timeout=90):
    """Poll the broker's own state until it confirms the radio is free.

    A command line looking idle is not evidence -- rtl_airband takes its device
    index from its config file, so scanning argv reports a held radio as free.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            st = json.load(open(STATE))
            for dev in (st.get("devices") or {}).values():
                if str(dev.get("physical_index")) != str(phys):
                    continue
                if dev.get("paused") and not dev.get("current_lane"):
                    return True
        except Exception:
            pass
        time.sleep(0.5)
    return False


def satdump_live(outdir, seconds, serial, freq_hz=LRPT_HZ, gain=48):
    """satdump drives the SDR directly. LRPT has no audio stage to insert."""
    os.makedirs(outdir, exist_ok=True)
    cmd = [satdump_bin(), "live", PIPELINE, outdir,
           "--source", "rtlsdr",
           "--samplerate", "%d" % int(SAMPLERATE),
           "--frequency", "%d" % int(freq_hz),
           # --gain, NOT --general_gain. satdump ACCEPTS --general_gain as a
           # parameter and echoes it back, but the RTL-SDR source ignores it
           # and leaves the tuner at "Set RTL-SDR Gain to 0.0". Verified by
           # reading the driver line back: --gain gives 48.0, --general_gain
           # gives 0.0. Minimum gain on a weak satellite downlink is another
           # guaranteed noise image.
           "--gain", str(gain),
           "--timeout", str(int(seconds))]
    if serial:
        cmd += ["--source_id", str(serial)]
    log("satdump live %s @ %.4f MHz, %d s, gain %s%s"
        % (PIPELINE, freq_hz / 1e6, seconds, gain,
           (", device %s" % serial) if serial else ""))
    r = subprocess.run(cmd, capture_output=True, text=True,
                       timeout=seconds + 600,
                       cwd=os.path.dirname(satdump_bin()))
    return r


def images_in(outdir):
    out = []
    for root, _d, files in os.walk(outdir):
        for f in sorted(files):
            if f.lower().endswith((".png", ".jpg")):
                out.append(os.path.join(root, f))
    return out


def load_passes(hours, min_el):
    import passes as P
    if not os.path.exists(TLE):
        refresh_tles()
    if not os.path.exists(TLE):
        return []
    lines = [l.rstrip("\n") for l in open(TLE) if l.strip()]
    now = datetime.now(timezone.utc)
    out = []
    for i in range(0, len(lines) - 2, 3):
        name = lines[i].strip()
        for p in P.next_passes(lines[i + 1], lines[i + 2], SITE[0], SITE[1],
                               SITE[2], start=now, hours=hours,
                               min_elevation_deg=min_el, name=name):
            out.append(p)
    out.sort(key=lambda p: p["start"])
    return out


def refresh_tles():
    parts = []
    for name, cat in CATNR.items():
        try:
            r = subprocess.run(
                ["curl", "-s", "--max-time", "20",
                 "https://celestrak.org/NORAD/elements/gp.php"
                 "?CATNR=%d&FORMAT=tle" % cat],
                capture_output=True, text=True, timeout=30)
            t = (r.stdout or "").strip()
            if t.count("\n") >= 2:
                parts.append(t)
        except Exception as e:
            log("TLE fetch failed for %s: %s" % (name, e))
    if parts:
        os.makedirs(os.path.dirname(TLE), exist_ok=True)
        open(TLE, "w").write("\n".join(parts) + "\n")
        log("TLEs refreshed")


def selftest():
    """Prove the radio opens and the pipeline starts, WITHOUT a pass.

    This is the check that would have caught the NOAA mistake earlier: it
    exercises everything except the satellite. It cannot tell you a satellite
    is transmitting -- only a pass can -- but it tells you the machinery is
    not the reason if nothing decodes.
    """
    phys, serial = low_band_radio()
    log("low-band radio: physical %s, serial %s" % (phys, serial))
    open(PAUSE_FMT % phys, "w").write(str(os.getpid()))
    _paused.append(phys)
    if not wait_for_release(phys, timeout=90):
        log("WARNING: broker never confirmed release")
    else:
        log("broker confirmed radio %s is free" % phys)
    out = os.path.join("/tmp", "lrpt_selftest")
    subprocess.run(["rm", "-rf", out], capture_output=True)
    r = satdump_live(out, 20, serial)
    cleanup()
    txt = (r.stdout or "") + (r.stderr or "")
    opened = ("Device" in txt or "rtlsdr" in txt.lower()) and "Error" not in txt[:400]
    for line in txt.splitlines():
        low = line.lower()
        if any(k in low for k in ("error", "device", "samplerate", "frequency",
                                  "gain", "pipeline", "started")):
            log("  " + line[:150])
    log("SELFTEST: %s" % ("radio opened and pipeline ran"
                          if r.returncode == 0 else
                          "returncode %d -- see lines above" % r.returncode))
    return 0 if r.returncode == 0 else 1


def capture(p, send=True):
    import passes as P
    start, end, secs = P.pass_window(p, MARGIN_S)
    phys, serial = low_band_radio()
    log("pass %s  %s -> %s  max %.1f deg"
        % (p["satellite"], p["start"][11:19], p["end"][11:19],
           p["max_elevation_deg"]))
    log("radio: physical %s (serial %s)" % (phys, serial))

    wait = (start - datetime.now(timezone.utc)).total_seconds()
    if wait > 0:
        log("waiting %.0f s for the pass" % wait)
        time.sleep(wait)

    open(PAUSE_FMT % phys, "w").write(str(os.getpid()))
    _paused.append(phys)
    if not wait_for_release(phys, timeout=90):
        log("WARNING: broker never confirmed release; recording anyway -- a "
            "partial capture beats no capture and a pass cannot be re-flown")
    else:
        log("broker confirmed radio %s is free" % phys)

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    outdir = os.path.join(OUTDIR, "%s_%s"
                          % (p["satellite"].replace(" ", "").replace("-", ""),
                             stamp))
    r = satdump_live(outdir, secs, serial)
    cleanup()                      # radio back BEFORE any post-processing

    imgs = images_in(outdir)
    if imgs:
        log("DECODED %d image(s):" % len(imgs))
        for i in imgs:
            log("   %s (%.0f KB)" % (os.path.basename(i),
                                     os.path.getsize(i) / 1024.0))
    else:
        log("no image decoded. satdump tail:")
        for line in ((r.stdout or "") + (r.stderr or "")).splitlines()[-14:]:
            log("   " + line[:150])
        log("Raw output kept at %s" % outdir)
    if send:
        send_to_signal(imgs, p, outdir)
    return imgs


def _rpc(payload, timeout=120):
    import urllib.request
    cfg = json.load(open(os.path.join(ROOT, "collector.json")))
    req = urllib.request.Request(
        cfg["signal_rpc"], data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read() or b"{}")


def send_to_signal(images, p, outdir):
    import base64
    cfg = json.load(open(os.path.join(ROOT, "collector.json")))
    if not cfg.get("notify_enabled"):
        log("notify disabled; not sending")
        return False
    # prefer composites and corrected products; they are the ones that look
    # like a picture rather than a raw channel strip
    def rank(f):
        b = os.path.basename(f).lower()
        return (0 if ("composite" in b or "rgb" in b) else
                1 if "corrected" in b else 2, b)
    picks = sorted(images, key=rank)[:2]

    text = ("%s LRPT pass\n%s -> %s UTC\nmax elevation %.1f deg\n"
            "137.900 MHz, decoded on the Mini."
            % (p["satellite"], p["start"][11:16], p["end"][11:16],
               p["max_elevation_deg"]))
    if not picks:
        text += "\n\nNo image decoded. Raw output kept at %s" % outdir
    base = {"jsonrpc": "2.0", "method": "send",
            "params": {"recipient": [cfg.get("signal_recipient")],
                       "message": text}, "id": "meteor"}
    if picks:
        try:
            atts = []
            for f in picks:
                with open(f, "rb") as fh:
                    atts.append("data:image/png;base64,"
                                + base64.b64encode(fh.read()).decode())
            q = json.loads(json.dumps(base))
            q["params"]["attachments"] = atts
            r = _rpc(q)
            if "error" not in r:
                log("sent to Signal: %s"
                    % ", ".join(os.path.basename(f) for f in picks))
                return True
            log("attachment refused: %s" % str(r.get("error"))[:120])
        except Exception as e:
            log("attachment failed: %s" % e)
    try:
        r = _rpc(base)
        log("sent text-only" if "error" not in r else "send failed")
        return "error" not in r
    except Exception as e:
        log("Signal send failed: %s" % e)
        return False


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--next", action="store_true")
    ap.add_argument("--at")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--hours", type=float, default=24)
    ap.add_argument("--min", type=float, default=25.0, dest="min_el")
    ap.add_argument("--no-signal", action="store_true")
    a = ap.parse_args()

    signal.signal(signal.SIGINT, lambda *x: (cleanup(), sys.exit(1)))
    signal.signal(signal.SIGTERM, lambda *x: (cleanup(), sys.exit(1)))

    try:
        if a.refresh:
            refresh_tles()
        if a.selftest:
            return selftest()

        ps = load_passes(a.hours, a.min_el)
        if not ps:
            log("no Meteor pass above %.0f deg in %g h" % (a.min_el, a.hours))
            return 0
        if a.list or not (a.next or a.at):
            phys, serial = low_band_radio()
            print("radio: physical %s (serial %s), 137.900 MHz LRPT\n"
                  % (phys, serial))
            now = datetime.now(timezone.utc)
            for p in ps:
                mins = (datetime.fromisoformat(p["start"]) - now).total_seconds() / 60
                print("  %-16s %s -> %s  max %4.1f deg   T+%.0f min"
                      % (p["satellite"], p["start"][5:16].replace("T", " "),
                         p["end"][11:16], p["max_elevation_deg"], mins))
            return 0
        target = ([x for x in ps if x["start"].startswith(a.at[:16])] or [None])[0] \
            if a.at else max(ps, key=lambda x: x["max_elevation_deg"])
        if not target:
            log("no pass matching %s" % a.at)
            return 1
        return 0 if capture(target, send=not a.no_signal) else 1
    finally:
        cleanup()


if __name__ == "__main__":
    sys.exit(main())
